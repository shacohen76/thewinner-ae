 app/privacy/page.tsx            |  5 +++--
 app/terms/page.tsx              |  5 +++--
 components/TrackingProvider.tsx |  2 +-
 lib/utils.ts                    |  2 +-
 9 files changed, 29 insertions(+), 25 deletions(-)

